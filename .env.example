# Copy to .env.local and fill in. Never commit .env.local.

# The PHP API (XAMPP Apache vhost locally)
API_URL=http://127.0.0.1:8080
# Must equal CLIENT_KEY in api/.env
API_CLIENT_KEY=
# Must equal REVALIDATE_SECRET in api/.env
REVALIDATE_SECRET=

# Public URL of this website
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Only "true" on the live site: lets search engines index pages
SITE_INDEXABLE=false

# Optional: the codes from Google Search Console and Bing Webmaster Tools ("HTML tag" verification),
# only the content="…" value. Leave empty when the site is verified another way (e.g. a DNS record).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
