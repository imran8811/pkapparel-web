# The website's settings. On Vercel: Project → Settings → Environment Variables.
# Locally: copy to .env.local and use the local values in the comments. Never commit .env.local.

# The PHP API (locally: http://127.0.0.1:8080, the XAMPP Apache vhost)
API_URL=https://api.pkapparel.com
# Must equal CLIENT_KEY in the API's .env
API_CLIENT_KEY=
# Must equal REVALIDATE_SECRET in the API's .env
REVALIDATE_SECRET=

# Public URL of this website (locally: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=https://www.pkapparel.com
# Only "true" on the live site: lets search engines index pages
SITE_INDEXABLE=false

# Optional: the codes from Google Search Console and Bing Webmaster Tools ("HTML tag" verification),
# only the content="…" value. Leave empty when the site is verified another way (e.g. a DNS record).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Countries whose visitors see "not available in your region" (ISO codes, comma-separated).
# Empty means the default list in proxy.ts (PK,IN,CN,BD). Crawlers and the admin panel are never blocked.
BLOCKED_COUNTRIES=PK,IN,CN,BD
